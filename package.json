{
  "name": "suatu-rewards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "dev:share": "node scripts/dev-share.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit firefox",
    "db:start": "supabase start && node scripts/write-env.mjs && node scripts/seed-demo.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/write-env.mjs && node scripts/seed-demo.mjs",
    "db:env": "node scripts/write-env.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "prepare": "husky",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts && prettier --write src/types/database.ts",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "icons": "node scripts/build-icons.mjs && prettier --write src/components/ui/icons/iconPaths.ts",
    "brand:sync": "node scripts/brand-sync.mjs",
    "e2e:visual": "playwright test --config playwright.visual.config.ts",
    "e2e:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "dev:cert": "node scripts/dev-cert.mjs",
    "lighthouse": "next build && lhci autorun --config=lighthouserc.cjs",
    "admin:create": "node scripts/create-admin.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "libphonenumber-js": "^1.13.15",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
