# Copy to .env.local — or run `pnpm db:env`, which fills these from the local Supabase.
# Server-side only: none of these are exposed to the browser (spec §3).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
MAILPIT_URL=http://127.0.0.1:55324
SUPABASE_STUDIO_URL=http://127.0.0.1:55323

# Optional (defaults shown)
# APP_URL=http://localhost:3000   # required in production: the app's public https address
# SMTP_HOST=127.0.0.1
# SMTP_PORT=55325
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM=Suatu Rewards <no-reply@suatu.test>
# LOGIN_MAX_FAILURES_PER_IP=30
